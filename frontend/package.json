{
  "name": "library-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../backend/src/main/resources/openapi.yaml -o src/api/schema.d.ts",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  }
}
