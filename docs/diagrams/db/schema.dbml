// Library app database schema (mirrors backend/src/main/resources/db/migration/V1__schema.sql)
// Paste into https://dbdiagram.io to render.

Table member {
  id bigint [pk]
  name text [not null]
}

Table book {
  id bigint [pk]
  title text [not null]
}

Table loan {
  id uuid [pk, note: 'Generated by the domain (LoanId.generate())']
  member_id bigint [not null, ref: > member.id]
  book_id bigint [not null, ref: > book.id]
  borrowed_at timestamptz [not null]
  returned_at timestamptz [note: 'NULL while the loan is active']

  Note: 'Partial unique index one_active_loan_per_book: UNIQUE (book_id) WHERE returned_at IS NULL. DBML cannot express the WHERE clause.'
}
